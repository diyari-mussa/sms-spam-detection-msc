<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" >

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="23dp">
            
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/textAlert"
                android:text="@string/delete_confirmation"
                android:paddingTop="5dp"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/noButton"
                android:background="@color/colorPrimary"
                android:text="@string/no_conf"
                android:layout_below="@id/textAlert"
                android:textColor="@android:color/white"
                android:layout_marginTop="19dp"/>

            <Button
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/yesButton"
                android:layout_alignParentRight="true"
                android:background="@color/colorRedLight"
                android:textColor="@android:color/white"
                android:text="@string/yes_conf"
                android:layout_alignBottom="@id/noButton"/>



        </RelativeLayout>
    </androidx.cardview.widget.CardView>
</LinearLayout>